# Enable debug logging
DEBUG=false

# Capsolver API Key
CAPSOLVER_API_KEY=

# Optional SEO provider: default is the existing Ahrefs/CapSolver implementation.
# Use your key from https://goanyapi.com/ when selecting GoAnyAPI.
# SEO_PROVIDER=goanyapi
# GOANYAPI_API_KEY=

# Cloudflare CDN
CLOUDFLARE_CDN_PROJECT_NAME="seo-insights"
CLOUDFLARE_CDN_BUCKET_NAME=""
CLOUDFLARE_CDN_ACCESS_KEY=""
CLOUDFLARE_CDN_SECRET_KEY=""
CLOUDFLARE_CDN_ENDPOINT_URL=""
CLOUDFLARE_CDN_BASE_URL=""
